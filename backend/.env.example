# 复制为 .env 并填入真实值（.env 已被 .gitignore 排除，切勿提交）

# DashScope（通义千问）API Key
# 获取地址：https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 模型
MODEL_NAME=qwen-plus
STREAM_ENABLED=true

# 服务
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 会话（分钟）：超过此时长无新增消息，再对话则开新会话
SESSION_TIMEOUT_MINUTES=30

# 智能体
AGENT_NAME=AI助手
MAX_ITERS=20

# ---- GeneralMemory 记忆服务（写入侧） ----
MEMORY_ENABLED=true
GM_BASE_URL=http://127.0.0.1:8001
# GM API Token（向 GM 管理员申请，勿提交真实值）
GM_TOKEN=your-gm-token-here
GM_SOURCE_SYSTEM=ai_assistant
GM_USER_ID=gm_user_lw
# save_memory 工具同步等待结果的最长时间（毫秒），GM 上限 30000
GM_WAIT_TIMEOUT_MS=15000

# ---- 记忆读取侧（每轮召回注入 system_prompt，v1.2.0 起默认走 GM API） ----
MEMORY_READ_ENABLED=true
# gm_api=调 GM HTTP search（推荐）；local=直连 GM Postgres 自建向量检索（回退用）
MEMORY_READ_BACKEND=gm_api
MEMORY_READ_LIMIT=5
MEMORY_READ_TIMEOUT_MS=2500
# 用户输入短于该长度时跳过记忆检索（画像不受影响，仍注入）
MEMORY_READ_MIN_QUERY_CHARS=2

# ---- 用户画像注入（v1.3.1，与记忆召回并行、独立降级） ----
MEMORY_PROFILE_ENABLED=true
# 是否包含治理推断出的画像（需 GM 侧 MEMORY_PROFILE_ALLOW_INFERRED=true 才有 inferred 数据）
MEMORY_PROFILE_INCLUDE_INFERRED=true
# 注入条数上限（GM 端点无分页，客户端 explicit 优先截断）
MEMORY_PROFILE_LIMIT=20
MEMORY_PROFILE_TIMEOUT_MS=2500

# ---- gm-memory MCP（GeneralMemory 只读工具，stdio 子进程，模型可按需主动查记忆） ----
MCP_GM_MEMORY_ENABLED=true
# 工具白名单（逗号分隔，空=全部）：memory_search,memory_task_status,memory_profile
MCP_GM_MEMORY_TOOLS=
# MCP 工具执行超时（秒）
MCP_GM_MEMORY_TIMEOUT_S=15
